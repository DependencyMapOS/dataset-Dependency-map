      <data key="kind">compound_statement</data>
      <data key="language">multi</data>
      <data key="source_path" />
      <data key="label">{
	if (callbackAlc)
		PANIC("alc", "Attempted to assign alc callback again");
	
	callbackAlc = &amp;alcEnabler;
	
	if (!callbackAlc)
		PANIC("alc", "Failed to assign alc callback");
}</data>
      <data key="commit_sha">b31765eb65de5536731b9fd88ead43d33ae502ef</data>
