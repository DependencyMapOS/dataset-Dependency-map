      <data key="kind">for_statement</data>
      <data key="language">multi</data>
      <data key="source_path" />
      <data key="label">for (p = tbl; p-&gt;str; p++)
	{
		if (!strncmp(str, p-&gt;str, len))
		{
			if (found)
			{
				fprintf(stderr, "No unique key '%s'\n", str);
				return -1;
			}
			
			found = p;
		}
	}</data>
