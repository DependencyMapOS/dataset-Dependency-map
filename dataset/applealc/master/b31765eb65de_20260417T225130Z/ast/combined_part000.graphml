    <node id="ast:b31765eb65de5536731b9fd88ead43d33ae502ef:AppleALC/kern_alc.cpp:10855:13077:preproc_ifdef">
      <data key="node_id">ast:b31765eb65de5536731b9fd88ead43d33ae502ef:AppleALC/kern_alc.cpp:10855:13077:preproc_ifdef</data>
      <data key="kind">preproc_ifdef</data>
      <data key="language">multi</data>
      <data key="source_path" />
      <data key="label">#ifdef HAVE_ANALOG_AUDIO
	if (isAnalog) {
