    <node id="ast:b31765eb65de5536731b9fd88ead43d33ae502ef:alc-verb/main.c:4310:4406:comment">
      <data key="node_id">ast:b31765eb65de5536731b9fd88ead43d33ae502ef:alc-verb/main.c:4310:4406:comment</data>
      <data key="kind">comment</data>
      <data key="language">multi</data>
      <data key="source_path" />
      <data key="label">// Convert Unix-style 4 bit verbs 0xn00 to Intel-style 4 bit verbs 0xn which Apple methods also</data>
      <data key="commit_sha">b31765eb65de5536731b9fd88ead43d33ae502ef</data>
      <data key="tool_version">0.1.0</data>
      <data key="ext_json" />
    </node>
    <node id="ast:b31765eb65de5536731b9fd88ead43d33ae502ef:alc-verb/main.c:4408:4501:comment">
      <data key="node_id">ast:b31765eb65de5536731b9fd88ead43d33ae502ef:alc-verb/main.c:4408:4501:comment</data>
      <data key="kind">comment</data>
      <data key="language">multi</data>
      <data key="source_path" />
      <data key="label">// use internally, to avoid IOHDACodecDevice_executeVerb discarding the top 8 bits of param.</data>
      <data key="commit_sha">b31765eb65de5536731b9fd88ead43d33ae502ef</data>
      <data key="tool_version">0.1.0</data>
      <data key="ext_json" />
    </node>
    <node id="ast:b31765eb65de5536731b9fd88ead43d33ae502ef:alc-verb/main.c:4503:4616:if_statement">
      <data key="node_id">ast:b31765eb65de5536731b9fd88ead43d33ae502ef:alc-verb/main.c:4503:4616:if_statement</data>
      <data key="kind">if_statement</data>
      <data key="language">multi</data>
      <data key="source_path" />
      <data key="label">if (verb &amp; 0xff) {
		// 12 bit verb
		input[1]	= verb;
	} else {
		// 4 bit verb
		input[1]	= verb &gt;&gt; 8;
	}</data>
      <data key="commit_sha">b31765eb65de5536731b9fd88ead43d33ae502ef</data>
      <data key="tool_version">0.1.0</data>
      <data key="ext_json" />
    </node>
