      <data key="kind">compound_statement</data>
      <data key="language">multi</data>
      <data key="source_path" />
      <data key="label">{
	if (!owningTask)
		return false;
	
	if (!super::initWithTask(owningTask, securityToken, type))
		return false;
	
	mTask = owningTask;
	mProvider = NULL;
	
	return true;
}</data>
