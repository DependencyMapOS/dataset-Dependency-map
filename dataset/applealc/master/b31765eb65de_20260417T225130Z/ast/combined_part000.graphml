    <node id="ast:b31765eb65de5536731b9fd88ead43d33ae502ef:AppleALC/kern_alc.cpp:4176:4347:compound_statement">
      <data key="node_id">ast:b31765eb65de5536731b9fd88ead43d33ae502ef:AppleALC/kern_alc.cpp:4176:4347:compound_statement</data>
      <data key="kind">compound_statement</data>
      <data key="language">multi</data>
      <data key="source_path" />
      <data key="label">{
					if (hda-&gt;requestTerminate(pci, 0) &amp;&amp; hda-&gt;terminate())
						hda-&gt;stop(pci);
					else
						SYSLOG("alc", "failed to terminate built-in digital audio");
				}</data>
      <data key="commit_sha">b31765eb65de5536731b9fd88ead43d33ae502ef</data>
      <data key="tool_version">0.1.0</data>
      <data key="ext_json" />
